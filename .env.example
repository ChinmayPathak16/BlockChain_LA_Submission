# ── Seller config ──────────────────────────────────────────────────────────────
# Ethereum address that receives USDC payments (Base Sepolia testnet)
PAY_TO_ADDRESS=0xYOUR_SELLER_WALLET_ADDRESS

# x402 facilitator URL (default works for testnet)
FACILITATOR_URL=https://x402.org/facilitator

# Network identifier
NETWORK=base-sepolia

# Public URL of your server (used by buyer CLI to locate the API)
SERVER_URL=http://localhost:8000

# ── Buyer config ────────────────────────────────────────────────────────────────
# Private key of the wallet that will pay for requests (testnet only — never real funds)
PRIVATE_KEY=0xYOUR_BUYER_PRIVATE_KEY
